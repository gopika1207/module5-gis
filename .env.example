# ==============================================================================
# Module 5: GPS + GIS Location Verification Configuration
# Tamil Nadu Geographical Information System (TNGIS) Integration
# ==============================================================================

# TNGIS Base API Gateway URL (Official TNeGA / TNGIS endpoint)
TNGIS_BASE_URL=https://tngis.tn.gov.in/api/v1

# Application identifier provided by TNeGA / TNGIS authority
TNGIS_APP_NAME=SmartAttendanceERP

# TNGIS API Authentication Token or Key (Leave empty if using IP/Intranet whitelist)
TNGIS_API_KEY=your_tngis_api_key_here

# Network HTTP Timeout in seconds
TNGIS_TIMEOUT_SECONDS=10.0

# SSL Certificate Verification (Set to False only for self-signed development gateways)
TNGIS_VERIFY_SSL=True

# Microservice Server Configuration
MODULE5_PORT=5005
MODULE5_HOST=0.0.0.0
DEBUG=False
